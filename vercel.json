{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/argon2/prebuilds/linux-x64/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}